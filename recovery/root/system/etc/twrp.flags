# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# mount point		fs			device						device2			 device3			flags
# User writeable partitions
/boot				emmc		/dev/block/by-name/boot											flags=display="Boot";slotselect;backup;flashimg
/vendor_boot		emmc		/dev/block/by-name/vendor_boot									flags=display="Vendor Boot";slotselect;backup;flashimg
/vbmeta				emmc		/dev/block/by-name/vbmeta										flags=display="VBMeta";slotselect;backup;flashimg
/vbmeta_system		emmc		/dev/block/by-name/vbmeta_system								flags=display="VBMeta System";slotselect;backup;flashimg
/vbmeta_vendor		emmc		/dev/block/by-name/vbmeta_vendor								flags=display="VBMeta Vendor";slotselect;backup;flashimg

# Firmware
/dtbo				emmc		/dev/block/by-name/dtbo											flags=display="DTBO";slotselect;backup
/metadata			ext4		/dev/block/by-name/metadata										flags=display="Metadata";backup
/misc				emmc		/dev/block/by-name/misc											flags=display="Misc";backup

# Sensitive Data
/nvcfg				ext4		/dev/block/by-name/nvcfg										flags=display="NVCFG";backup
/persist_image		emmc		/dev/block/by-name/persist										flags=display="Persist";backup
/persistent			emmc		/dev/block/by-name/frp											flags=display="Persistent (FRP)";backup

# IMEI and modem related
/nvdata				ext4		/dev/block/by-name/nvdata										flags=display="NVData";backup
/protect_f			ext4		/dev/block/by-name/protect1										flags=display="Protect F";backup
/protect_s			ext4		/dev/block/by-name/protect2										flags=display="Protect S";backup
/nvram				emmc		/dev/block/by-name/nvram										flags=display="NVRAM";backup

# Standard MediaTeks's partitions
/expdb				emmc		/dev/block/by-name/expdb										flags=display="EXPDB"
/logo				emmc		/dev/block/by-name/logo											flags=display="Boot Logo";slotselect;backup
/otp				emmc		/dev/block/by-name/otp											flags=display="OTP"
/seccfg				emmc		/dev/block/by-name/seccfg										flags=display="SecCfg"
/spmfw				emmc		/dev/block/by-name/spmfw										flags=display="SPM Firmware";slotselect
/tee1				emmc		/dev/block/by-name/tee1											flags=display="TEE 1"
/tee2				emmc		/dev/block/by-name/tee2											flags=display="TEE 2"

# Removable Storage
/usb_otg			auto		/dev/block/sdd1				/dev/block/sdd						flags=display="USB OTG";storage;wipeingui;removable;backup=0

# Flashable logical partitions
/system_image		emmc		/dev/block/bootdevice/by-name/system							flags=display="System Image";backup;flashimg
/vendor_image		emmc		/dev/block/bootdevice/by-name/vendor							flags=display="Vendor Image";backup;flashimg
/system_ext_image	emmc		/dev/block/bootdevice/by-name/system_ext						flags=display="System Ext Image";backup;flashimg
/product_image		emmc		/dev/block/bootdevice/by-name/product							flags=display="Product Image";backup;flashimg
/vendor_dlkm_image	emmc		/dev/block/bootdevice/by-name/vendor_dlkm						flags=display="Vendor DLKM Image";backup;flashimg
